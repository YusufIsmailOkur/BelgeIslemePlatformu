{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=storeapp.db"
  },
  "Storage": {
    "RootPath": "App_Data/uploads",
    "MaxFileSizeMb": 10
  },
  "Ocr": {
    "TessDataPath": "App_Data/tessdata",
    "Language": "tur+eng"
  },
  "Gemini": {
    "Enabled": false,
    "ApiKey": "",
    "Model": "gemini-2.5-flash",
    "TimeoutSeconds": 30
  }
}
